{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**.csproj"
          ],
          "src": "../../src",
          "exclude": [
            "**/example/**",
            "**/test/**",
            "**/WebEntryPoint/**",
            "**/ConsoleApps/**",
            "**/Plugins/**"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout":"nested",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.yml",
          "articles/intro.md",
          "articles/getting-started/**/*.md",
          "articles/concepts/**/*.md",
          "articles/user-guide/**/*.md",
          "articles/developer-guide/**/*.md",
          "articles/toc.yml",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**",
          "logo.png",
          "favicon.ico"
        ]
      }
    ],
    "overwrite": [],
    "dest": "_site",
    "globalMetadata": {
      "_appName":"JJMasterData",
      "_disableToc": false,
      "_disableContribution": false,
      "_enableSearch": true,
      "_gitContribute": {
        "branch": "main",
        "apiSpecFolder":"api",
        "repo": "https://github.com/jjconsulting/JJMasterData"
      },
      "_gitUrlPattern": "github",
      "_disableSideFilter":true,
      "_appLogoPath": "logo.png",
      "_googleAnalyticsTagId" : "G-60L9XB7X4J",
      "_appFooter": "Moon Version - 5.0.x",
      "_copyrightFooter":"2026 JJConsulting. All rights reserved."
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "themes/jjmasterdata"
    ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "noLangKeyword": false,
    "keepFileLink": true,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "warningsAsErrors": true
  }
}
