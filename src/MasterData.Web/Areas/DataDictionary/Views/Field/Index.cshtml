@using System.Text
@using JJConsulting.FontAwesome
@using JJMasterData.Commons.Data.Entity.Models
@using JJMasterData.Core.DataDictionary.Models


@model JJMasterData.Core.DataDictionary.Models.FormElementField
@inject IOptionsSnapshot<MasterDataWebOptions> Options
@inject IStringLocalizer<MasterDataResources> StringLocalizer

@{
    ViewData["Title"] = $"{ViewData["ElementName"]} - {StringLocalizer["Fields"]}";
    var isForm = ViewData["IsForm"] is true;
    var elementName = ViewData["ElementName"]!.ToString();
    var fields = (FormElementFieldList)ViewData["Fields"]!;
    Layout = !isForm ? Options.Value.ModalLayoutPath : "_FormElementMenuLayout";

    var componentList = Html.GetEnumSelectList<FormComponent>().ToList();

    if (!isForm)
        componentList.RemoveAll(c => c.Text == "File");

    foreach (var component in componentList)
        component.Group.Name = StringLocalizer[component.Group.Name];

    ViewData["ComponentList"] = componentList;

    var dataTypeList = Html.GetEnumSelectList<FieldType>().ToList();

    foreach (var dataType in dataTypeList)
        dataType.Group.Name = StringLocalizer[dataType.Group.Name];

    ViewData["DataTypeList"] = dataTypeList;
}

@functions{
    static string GetFieldDataTypeText(FormElementField field)
    {
        var sql = new StringBuilder();
        sql.Append(field.DataType.GetDisplayName());

        if (field.DataType.SupportsSize)
        {
            sql.Append('(');
            sql.Append(field.Size == -1 ? "MAX" : field.Size);
            sql.Append(')');
        }

        if (field.IsRequired)
            sql.Append(" NOT NULL");

        if (field is { AutoNum: true, DataType: not FieldType.UniqueIdentifier })
            sql.Append(" IDENTITY ");

        return sql.ToString();
    }


    static FontAwesomeIcon GetFontAwesomeIconClass(FormComponent component)
    {
        return component switch
        {
            FormComponent.Text => FontAwesomeIcon.KeyboardO,
            FormComponent.TextArea => FontAwesomeIcon.AlignLeft,
            FormComponent.Hour => FontAwesomeIcon.ClockO,
            FormComponent.Date or FormComponent.DateTime => FontAwesomeIcon.Calendar,
            FormComponent.Password => FontAwesomeIcon.Lock,
            FormComponent.Email => FontAwesomeIcon.Envelope,
            FormComponent.Number => FontAwesomeIcon.Calculator,
            FormComponent.ComboBox => FontAwesomeIcon.CaretDown,
            FormComponent.Search => FontAwesomeIcon.Search,
            FormComponent.RadioButtonGroup => FontAwesomeIcon.RegularCircleDot,
            FormComponent.CheckBox => FontAwesomeIcon.CheckSquare,
            FormComponent.Cnpj => FontAwesomeIcon.SolidBuildingColumns,
            FormComponent.Cpf => FontAwesomeIcon.RegularIdCard,
            FormComponent.CnpjCpf => FontAwesomeIcon.RegularIdBadge,
            FormComponent.Currency => FontAwesomeIcon.Dollar,
            FormComponent.Tel or FormComponent.Phone => FontAwesomeIcon.Phone,
            FormComponent.Cep => FontAwesomeIcon.MapMarker,
            FormComponent.Lookup => FontAwesomeIcon.Binoculars,
            FormComponent.File => FontAwesomeIcon.File,
            FormComponent.Slider => FontAwesomeIcon.Sliders,
            FormComponent.Color => FontAwesomeIcon.SolidPaintbrush,
            FormComponent.Icon => FontAwesomeIcon.SolidIcons,
            FormComponent.CodeEditor => FontAwesomeIcon.Code,
            FormComponent.Percentage => FontAwesomeIcon.Percent,
            _ => FontAwesomeIcon.Question
        };
    }
}

@if (ViewData["ShowSaveSuccess"] is true)
{
    <message-toast
        title-color="Success"
        title="@StringLocalizer["Success"]"
        icon="@FontAwesomeIcon.CheckCircle"
        name="field-save-success"
        show-as-opened="true"
        message="@StringLocalizer["Field saved successfully."]" />
}
@if (!ViewData.ModelState.IsValid)
{
    <message-toast
        title-color="Danger"
        title="@StringLocalizer["Error"]"
        icon="@FontAwesomeIcon.TimesCircle"
        name="field-validation-error"
        show-as-opened="true"
        message="@StringLocalizer["Please check the validation errors."]" />
}

<div class="modal modal-md fade" id="fieldFilterModal" tabindex="-1" aria-labelledby="fieldFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fieldFilterModalLabel">@StringLocalizer["Advanced Filters"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@StringLocalizer["Close"]"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-4 mb-3">
                        <label for="fieldFilterDataType" class="form-label">@StringLocalizer["Data Type"]</label>
                        <select id="fieldFilterDataType" class="form-select">
                            <option value="">@StringLocalizer["All"]</option>
                            @foreach (var group in dataTypeList.GroupBy(t => t.Group.Name).OrderBy(g => g.Key))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var type in group.OrderBy(t => t.Text))
                                    {
                                        <option value="@type.Value">@type.Text</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label for="fieldFilterComponent" class="form-label">@StringLocalizer["Component Type"]</label>
                        <select id="fieldFilterComponent"
                                class="form-control form-select"
                                onchange="this.form.submit();">
                            <option value="">@StringLocalizer["All"]</option>
                            @foreach (var group in componentList.GroupBy(c => c.Group.Name).OrderBy(g => g.Key))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var component in group.OrderBy(c => c.Text))
                                    {
                                        <option value="@component.Value">@component.Text</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label for="fieldFilterBehavior" class="form-label">@StringLocalizer["Behavior"]</label>
                        <select id="fieldFilterBehavior" class="form-select">
                            <option value="">@StringLocalizer["All"]</option>
                            @foreach (var behavior in Html.GetEnumSelectList<FieldBehavior>())
                            {
                                <option value="@behavior.Value">@behavior.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fieldFilterPk">
                            <label class="form-check-label" for="fieldFilterPk">@StringLocalizer["Primary Key"]</label>
                        </div>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fieldFilterAutoPostBack">
                            <label class="form-check-label" for="fieldFilterAutoPostBack">@StringLocalizer["AutoPostBack"]</label>
                        </div>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="fieldFilterRequired">
                            <label class="form-check-label" for="fieldFilterRequired">@StringLocalizer["Required"]</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary ms-1" data-bs-dismiss="modal" onclick="applyFieldFilters()">
                    <span class="fa fa-search text-primary"></span>&nbsp;@StringLocalizer["Filter"]
                </button>
                <button type="button" class="btn btn-secondary ms-1" data-bs-dismiss="modal" onclick="clearFieldFilters()">
                    <span class="fa fa-trash"></span>&nbsp;@StringLocalizer["Clear Filters"]
                </button>
            </div>
        </div>
    </div>
</div>


@if (isForm)
{
    <div class="modal fade" id="copyFromModal" tabindex="-1" aria-labelledby="copyFromModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="copyFromModalLabel">@StringLocalizer["Copy From..."]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="copyFromForm" asp-action="CopyFrom" asp-controller="Field"
                          asp-route-elementName="@elementName">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label for="copyFromElementName"
                                           class="form-label">@StringLocalizer["Element Name"]</label>
                                    <select name="copyFromElementName"
                                            id="copyFromElementName"
                                            asp-items="@(new SelectList(ViewBag.ElementNameList, "Key", "Value"))"
                                            onchange="populateCopyFromFields(this)"
                                            required
                                            class="form-select">
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label for="copyFromFieldNames"
                                           class="form-label">@StringLocalizer["Fields"]</label>
                                    <select name="copyFromFieldNames"
                                            id="copyFromFieldNames"
                                            required
                                            multiple
                                            class="form-select">
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" form="copyFromForm">
                        <i class="fa-solid fa-copy"></i>&nbsp;@StringLocalizer["Copy"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@using (Html.BeginMasterDataForm("Index", "Field", new { elementName }))
{
    <input type="hidden" name="selected-tab" id="selected-tab" value="@ViewBag.Tab"/>
    <div class="row">
        <div class="col-sm-3">
            <div class="input-group" id="field-input-group">
                <input id="txtFilter" name="txtFilter" onkeyup="searchFields();"
                       placeholder="@StringLocalizer["Search..."]" type="text" class="form-control"
                       data-bs-toggle="tooltip" title="@StringLocalizer["Filter by any field visible in the list"]">

                <button type="button" id="fieldFilterButton" class="input-group-text position-relative" data-bs-toggle="tooltip"
                        title="@StringLocalizer["Advanced Filters"]" aria-label="@StringLocalizer["Advanced Filters"]"
                        aria-pressed="false"
                        onclick="showFieldFilterModal()">
                    <i class="fa-solid fa-filter"></i>
                    <span id="fieldFilterIndicator"
                          class="position-absolute top-0 end-0 p-1 bg-primary border border-primary border-opacity-50 rounded-circle d-none"
                          aria-hidden="true"></span>
                </button>

                @if (isForm)
                {
                    <button class="input-group-text" style="cursor:pointer" data-bs-toggle="tooltip"
                            title="@StringLocalizer["Import Fields From Table"]"
                            asp-route-elementName="@elementName"
                            asp-action="ImportFields"
                         type="submit">
                        <i class="fa-solid fa-upload"></i>
                    </button>
                    <div class="input-group-text" style="cursor:pointer" data-bs-toggle="tooltip"
                         title="@StringLocalizer["Copy From..."]"
                         onclick="showCopyFromModal()">
                        <i class="fa-solid fa-copy"></i>
                    </div>
                }

                <div class="input-group-text" style="cursor:pointer" data-bs-toggle="tooltip"
                     title="@StringLocalizer["Add"]"
                     onclick="loadFieldDetails('@Url.Action("Add", new { elementName })', '');">
                    <i class="fa fa-plus"></i>
                </div>
            </div>
            <br/>
            <div class="jjrelative">
                <div id="field-list">
                    <div class="list-group jj-list-group jjsortable" id="sortable-grid">
                        @if (fields.Count == 0)
                        {
                            <div>@StringLocalizer["No record found"]</div>
                        }
                        @for (var i = 0; i < fields.Count; i++)
                        {
                            var field = fields[i];
                            var fieldName = field.Name;

                            <a href="javascript:loadFieldDetails('@Url.Action("Detail", new { elementName = elementName, fieldName })', '@fieldName' );"
                               class="list-group-item @(fieldName.Equals(Model.Name) ? "active" : "")"
                               data-data-type="@((int)field.DataType)"
                               data-component="@((int)field.Component)"
                               data-behavior="@((int)field.DataBehavior)"
                               data-pk="@field.IsPk.ToString().ToLowerInvariant()"
                               data-auto-postback="@field.AutoPostBack.ToString().ToLowerInvariant()"
                               data-required="@field.IsRequired.ToString().ToLowerInvariant()"
                               id="@fieldName">
                                <div style="height: 33px;">
                                    <div class="float-start">
                                        <b>@fieldName</b>
                                        @if (field.IsPk)
                                        {
                                            <span class="fa fa-star text-warning" data-bs-toggle="tooltip"
                                                  title="@StringLocalizer["Primary key"]"></span>
                                        }
                                        @if (field.Component is not FormComponent.Text)
                                        {
                                            <span class="@GetFontAwesomeIconClass(field.Component).CssClass ms-1"
                                                  data-bs-toggle="tooltip" title="@field.Component.ToString()"></span>
                                        }
                                        @if (field.Filter.Type is not FilterMode.None)
                                        {
                                            <span class="@FontAwesomeIcon.Filter.CssClass ms-1" data-bs-toggle="tooltip"
                                                  title="@field.Filter.Type.ToString()"></span>
                                        }
                                        @if (field.AutoPostBack)
                                        {
                                            <span class="@FontAwesomeIcon.SolidBoltLightning.CssClass text-warning ms-1"
                                                  data-bs-toggle="tooltip" title="AutoPostBack"></span>
                                        }
                                        <br>
                                        <small>
                                            @if (field.Label != null && !string.Equals(fieldName, field.Label, StringComparison.InvariantCultureIgnoreCase))
                                            {
                                                var label = field.Label.Replace("<br>", " ").Replace("<BR>", " ").Replace("<br />", " ");
                                                if (label.Length > 35)
                                                {
                                                    label = $"{label[..30]}...";
                                                }

                                                <span>@label</span>
                                                <span> - </span>
                                            }

                                            @GetFieldDataTypeText(field)
                                        </small>
                                    </div>
                                    <div class="float-end jjsortable-icon"
                                         title="@StringLocalizer["Drag and drop to move"]">
                                    </div>
                                    <span class="float-end jjsortable-span"
                                          title="@StringLocalizer["Drag and drop to move"]">
                                        @i
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-9" style="padding-left:0px">
            <div class="jjrelative" id="field-details">
                    <partial name="_Detail" model="Model"/>
            </div>
        </div>
        <br/>
    </div>
}



<script type="text/javascript">

    function saveScrollPosition() {
        const listField = document.getElementById('field-list');
        if (listField) {
            sessionStorage.setItem('listFieldScrollPosition', listField.scrollTop);
        }
    }

    function restoreScrollPosition() {
        const listField = document.getElementById('field-list');
        const savedScrollPosition = sessionStorage.getItem('listFieldScrollPosition');
        if (listField && savedScrollPosition) {
            listField.scrollTop = parseInt(savedScrollPosition);
            sessionStorage.removeItem('listFieldScrollPosition');
        }
    }

    document.addEventListener("DOMContentLoaded", restoreScrollPosition)
    window.addEventListener('beforeunload', saveScrollPosition);


    function showCopyFromModal() {
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('copyFromModal'));
        modal.show();
    }

    async function populateCopyFromFields(formElementCombobox) {
        const fieldNamesSelect = document.getElementById('copyFromFieldNames');
        if (!fieldNamesSelect) return;

        const response = await fetch('@Url.Action("PopulateCopyFromFields", "Field")' + '?elementName=' + formElementCombobox.value);

        if (!response.ok)
            return;

        fieldNamesSelect.innerHTML = await response.text();
    }
</script>

<script type="text/javascript">
    let activeFieldFilters = null;

    function showFieldFilterModal() {
        const filters = activeFieldFilters;
        document.getElementById('fieldFilterDataType').value = filters?.dataType ?? '';
        document.getElementById('fieldFilterComponent').value = filters?.component ?? '';
        document.getElementById('fieldFilterBehavior').value = filters?.behavior ?? '';
        document.getElementById('fieldFilterPk').checked = filters?.pk ?? false;
        document.getElementById('fieldFilterAutoPostBack').checked = filters?.autoPostBack ?? false;
        document.getElementById('fieldFilterRequired').checked = filters?.required ?? false;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('fieldFilterModal')).show();
    }

    function applyFieldFilters() {
        activeFieldFilters = {
            dataType: document.getElementById('fieldFilterDataType').value,
            component: document.getElementById('fieldFilterComponent').value,
            behavior: document.getElementById('fieldFilterBehavior').value,
            pk: document.getElementById('fieldFilterPk').checked,
            autoPostBack: document.getElementById('fieldFilterAutoPostBack').checked,
            required: document.getElementById('fieldFilterRequired').checked
        };
        updateFieldFilterIndicator();
        searchFields();
    }

    function updateFieldFilterIndicator() {
        const filters = activeFieldFilters;
        const hasFilters = !!filters && Object.values(filters).some(Boolean);
        document.getElementById('fieldFilterIndicator').classList.toggle('d-none', !hasFilters);
        document.getElementById('fieldFilterButton').setAttribute('aria-pressed', String(hasFilters));
    }

    function clearFieldFilters() {
        document.getElementById('fieldFilterDataType').value = '';
        document.getElementById('fieldFilterComponent').value = '';
        document.getElementById('fieldFilterBehavior').value = '';
        document.getElementById('fieldFilterPk').checked = false;
        document.getElementById('fieldFilterAutoPostBack').checked = false;
        document.getElementById('fieldFilterRequired').checked = false;
        document.getElementById('txtFilter').value = '';
        activeFieldFilters = null;
        updateFieldFilterIndicator();
        searchFields();
    }

    document.addEventListener("DOMContentLoaded", function () {
        sortableGrid();
        saveTabState();
    })


    function saveTabState() {
        let currentTab = document.querySelector("#selected-tab").value;
        if (!currentTab) {
            currentTab = "#div-general";
        }

        let tabLinks = document.querySelectorAll("[data-bs-toggle='tab']");
        tabLinks.forEach(function (link) {
            if (link.getAttribute('href') === currentTab) {
                link.classList.add('active');
                link.classList.add('show');
            } else {
                link.classList.remove('active');
                link.classList.remove('remove');
            }
        });

        document.querySelectorAll(".tab-pane").forEach(function (tabPane) {
            if (tabPane.id === currentTab.replace("#", "")) {
                tabPane.classList.add('active');
                tabPane.classList.add('show');
            } else {
                tabPane.classList.remove('active');
                tabPane.classList.remove('remove');
            }
        })

        document.querySelector(currentTab).classList.add('active');
        document.querySelector(currentTab).classList.add('show');

        tabLinks.forEach(function (tabLink) {
            tabLink.addEventListener("click", function (e) {

                document.querySelector("#selected-tab").value = e.target.getAttribute("href");
            });
        });
    }

    function sortableGrid() {
        $("#sortable-grid").sortable({
            update: function () {
                const order = $(this).sortable('toArray');
                moveFields(order);
            }
        });
    }

    function moveFields(order) {
        const formData = new FormData();
        formData.append('fieldsOrder', order);
        fetch('@Url.Action("Sort", new { elementName })', {
            method: "POST",
            body: formData
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error('@StringLocalizer["Error while ordering fields."]');
                }
            })
            .catch(error => {
                messageBox.show('@StringLocalizer["Error"]', error.message, 4);
            });
    }

    function loadFieldDetails(url, fieldName) {
        const safeFieldName = fieldName.replace(/[^\w-]/g, '\\$&');

        document.querySelector("#sortable-grid .active")?.classList?.remove("active");

        if (safeFieldName !== "" && safeFieldName !== '\\_') {
            const element = document.querySelector("#" + safeFieldName);
            if (element) {
                element.classList.add("active");
            }
        }

        SpinnerOverlay.show();

        fetch(url).then((response) => response.text()).then((html) => {
            HTMLHelper.setInnerHTML("field-details", html);

            listenAllEvents("#field-details");
            saveTabState();
            SpinnerOverlay.hide();
        });
    }

    function searchFields() {
        const value = document.getElementById('txtFilter').value.toLowerCase();
        $("#sortable-grid a").filter(function () {
            const textValues = $(this).clone().find('select').remove().end().text();
            const isSearch = textValues.toLowerCase().indexOf(value) > -1;
            const data = this.dataset;
            const filters = activeFieldFilters;
            const matchesFilters = !filters ||
                (!filters.dataType || data.dataType === filters.dataType) &&
                (!filters.component || data.component === filters.component) &&
                (!filters.behavior || data.behavior === filters.behavior) &&
                (!filters.pk || data.pk === 'true') &&
                (!filters.autoPostBack || data.autoPostback === 'true') &&
                (!filters.required || data.required === 'true');

            $(this).toggle(isSearch && matchesFilters);
        });
    }
</script>
