@inject IStringLocalizer<MasterDataResources> StringLocalizer
@using JJMasterData.Core.DataDictionary.Models
@model JJMasterData.Core.DataDictionary.Models.FormElementPanel

<div class="row g-3 align-items-center panel-field-selection">
    <div class="col-12 col-sm-5">
        <label for="listEnabled" class="form-label">@StringLocalizer["Available Fields"]</label>
        <select size="10" name="listEnabled" id="listEnabled" multiple
                class="form-control form-select" ondblclick="addFields()">
            @foreach (FormElementField field in ViewBag.AvailableFields)
            {
                <option value="@field.Name">@field.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-sm-2 d-flex flex-sm-column justify-content-center align-items-center gap-2">
        <button type="button" class="@BootstrapHelper.BtnDefault"
                data-bs-toggle="tooltip" title="@StringLocalizer["Add"]"
                aria-label="@StringLocalizer["Add"]" onclick="addFields()">
            <span class="fa fa-angle-double-right fa-fw" aria-hidden="true"></span>
        </button>
        <button type="button" class="@BootstrapHelper.BtnDefault"
                data-bs-toggle="tooltip" title="@StringLocalizer["Remove"]"
                aria-label="@StringLocalizer["Remove"]" onclick="removeFields()">
            <span class="fa fa-angle-double-left fa-fw" aria-hidden="true"></span>
        </button>
    </div>
    <div class="col-12 col-sm-5">
        <label for="listSelected" class="form-label">@StringLocalizer["Selected Fields"]</label>
        <select size="10" name="listSelected" id="listSelected" multiple
                class="form-control form-select" ondblclick="removeFields()">
            @foreach (FormElementField field in ViewBag.SelectedFields)
            {
                <option value="@field.Name">@field.Name</option>
            }
        </select>
    </div>
    <div class="col-12 d-flex justify-content-end gap-2">
        <button type="button" class="@BootstrapHelper.BtnDefault"
                data-bs-toggle="tooltip" title="@StringLocalizer["Move Up"]"
                aria-label="@StringLocalizer["Move Up"]" onclick="moveUp()">
            <span class="fa fa-arrow-circle-up fa-fw" aria-hidden="true"></span>
        </button>
        <button type="button" class="@BootstrapHelper.BtnDefault"
                data-bs-toggle="tooltip" title="@StringLocalizer["Move Down"]"
                aria-label="@StringLocalizer["Move Down"]" onclick="moveDown()">
            <span class="fa fa-arrow-circle-down fa-fw" aria-hidden="true"></span>
        </button>
    </div>
</div>
